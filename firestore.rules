rules_version = '2';

// ============================================================
// 단순화 버전: 로그인한 사용자는 대부분의 데이터를 자유롭게 쓸 수 있습니다.
// (포인트/도박 조작 방지 같은 서버 측 검증은 포기하고, 대신 배포를
// 훨씬 간단하게 만든 버전입니다 — Cloud Functions가 필요 없습니다.)
//
// 그래도 익명 게시판의 핵심인 "다른 사람이 누구인지 알 수 없게" 하는
// 부분은 여기 규칙으로 지켜집니다: 일반 사용자는 자기 자신의 프로필과
// 관리자들의 프로필만 읽을 수 있고, 다른 사용자의 실명은 읽을 수 없습니다.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    match /users/{uid} {
      allow get: if signedIn() && (uid == request.auth.uid || resource.data.isAdmin == true || isAdmin());
      allow list: if signedIn();
      allow write: if signedIn();
    }

    match /posts/{postId} {
      allow read, write: if signedIn();
      match /likes/{uid} { allow read, write: if signedIn(); }
      match /comments/{commentId} { allow read, write: if signedIn(); }
    }

    match /chatRooms/{roomId} {
      allow read: if signedIn();
      allow write: if signedIn();
      match /messages/{msgId} { allow read, write: if signedIn(); }
      match /reads/{uid} { allow read, write: if signedIn(); }
    }

    match /notifications/{notifId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    match /gambleLogs/{logId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }
  }
}
